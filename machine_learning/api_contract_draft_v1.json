{
    "api_contract_version": "1.0-draft",
    "last_updated": "2025-xx-xx",
    "note": "Draft berdasarkan eksperimen Fase 8A-8B. Final di Fase 10.",
    "endpoint": "POST /api/ml/predict",
    "request": {
        "description": "Data sensor satu mesin pada satu timestamp",
        "content_type": "application/json",
        "body": {
            "machine_id": "string — contoh: M-01",
            "timestamp": "string ISO8601 — contoh: 2025-09-30T03:00:00",
            "sensor_readings": {
                "temperature": "float",
                "vibration": "float",
                "pressure": "float",
                "rpm": "int",
                "power_consumption": "float",
                "noise_level": "float",
                "humidity": "float",
                "operating_hours": "float"
            },
            "note": "endpoint ini menerima raw sensor dan ML service yang melakukan transformasi."
        }
    },
    "response": {
        "content_type": "application/json",
        "body": {
            "machine_id": "string",
            "timestamp": "string ISO8601",
            "model_1_classifier": {
                "predicted_label": "string — HEALTHY | WARNING | CRITICAL",
                "predicted_code": "int — 0 | 1 | 2",
                "confidence": "float — max probability dari ketiga kelas",
                "probabilities": {
                    "HEALTHY": "float — P(HEALTHY)",
                    "WARNING": "float — P(WARNING)",
                    "CRITICAL": "float — P(CRITICAL)"
                },
                "threshold_used": {
                    "WARNING": 0.60,
                    "CRITICAL": 0.50,
                    "note": "WARNING threshold di-tune dari default 0.50 ke 0.60 untuk minimasi false alarm"
                }
            },
            "model_2_rul": {
                "rul_days": "float — prediksi sisa umur dalam hari",
                "rul_hours": "float — rul_days × 24 (untuk referensi)",
                "urgency_level": "string — kalkulasi dari Safety Margin Calculator",
                "note": "rul_days < 2 → CRITICAL, 2-7 → WARNING, > 7 → HEALTHY"
            },
            "metadata": {
                "model_1_version": "string — rf_classifier | xgb_classifier | lgbm_classifier",
                "model_2_version": "string — xgb_regressor | lstm_regressor",
                "inference_time_ms": "float",
                "pipeline_version": "string"
            }
        }
    },
    "error_response": {
        "status": "error",
        "code": "int — HTTP status code",
        "message": "string — deskripsi error"
    }
}