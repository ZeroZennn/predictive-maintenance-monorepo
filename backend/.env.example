# ============================================
# LAPIS AI BACKEND — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# BACKEND
BACKEND_PORT=3000
NODE_ENV=development

# POSTGRESQL (Relational DB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=lapis_ai_db

# TIMESCALEDB (Time-Series DB)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=
TIMESCALE_PASSWORD=
TIMESCALE_DB=lapis_timeseries_db

# REDIS (Cache & Message Broker)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ML ENGINE
# Development: http://localhost:8000
# Docker: http://ml-service:8000
ML_ENGINE_URL=http://localhost:8000
ML_ENGINE_PORT=8000

# NLP ENGINE
# Development: http://localhost:8001
# Docker: http://nlp-service:8001
NLP_ENGINE_URL=http://localhost:8001
NLP_ENGINE_PORT=8001

# JWT AUTHENTICATION
JWT_SECRET=
JWT_EXPIRES_IN=7d

# INTERNAL API KEY (for NLP Engine callback)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# FILE STORAGE
# Development: absolute path to backend/uploads/
# Docker: /app/uploads
STORAGE_PATH=./uploads
