# ============================================================
# LAPIS AI — NLP Pipeline Environment Variables
# ============================================================
# Salin file ini menjadi .env dan isi nilainya.
# JANGAN commit file .env ke repository!
# ============================================================

# ── LLM API Keys ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ── Vector Database ─────────────────────────────────────────
# Untuk ChromaDB (default, local) — tidak perlu konfigurasi tambahan.
# Untuk Qdrant Cloud (opsional):
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# ── Backend Service ─────────────────────────────────────────
# URL backend utama (Django/FastAPI) yang menyediakan data mesin
BACKEND_URL=http://localhost:8000
BACKEND_API_TOKEN=your-backend-service-token-here

# ── NLP API Server ───────────────────────────────────────────
NLP_API_HOST=0.0.0.0
NLP_API_PORT=8001
NLP_SECRET_KEY=your-secret-key-for-nlp-api-here

# ── Environment ──────────────────────────────────────────────
# development | production
ENVIRONMENT=development

# ── Logging ──────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── HuggingFace (opsional, untuk model gated) ────────────────
HF_TOKEN=your-huggingface-token-here
