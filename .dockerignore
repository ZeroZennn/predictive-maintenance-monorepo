# ─────────────────────────────────────────────────────────────
# LAPIS AI — MONOREPO .dockerignore
# Digunakan saat docker build dengan context: . (root monorepo)
# Mencegah file yang tidak perlu dikirim ke Docker build daemon
# ─────────────────────────────────────────────────────────────

# Version control
.git/
.gitignore

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/*.egg-info/

# Data files — tidak perlu di dalam image (akan di-mount via volume)
nlp/data/raw/
nlp/data/processed/
nlp/data/vector_db/

# ML model artifacts (service ML punya Dockerfile sendiri)
machine_learning/models/
machine_learning/data/

# Development & editor files
.venv/
venv/
**/.env
*.log
.DS_Store
**/*.ipynb
**/.ipynb_checkpoints/

# Frontend build artifacts
frontend/node_modules/
frontend/.next/
frontend/build/

# IDE files
.vscode/
.idea/
